#!/usr/bin/env python3
"""Promote a workspace to the top of the sidebar once dwelled in for N seconds.

Fires on workspace.focused and on tab.focused. Herdr has no timer event, so the
hook stamps state, returns immediately, and hands off to a DETACHED child that
sleeps for the dwell period and then promotes — provided focus never moved.

Two events are needed because neither sees every focus change on Herdr 0.9.0:
workspace.focused fires only for API-driven focus, and tab.focused is what
follows the user's own clicks and shortcuts. So the hook runs far more often
than the focused workspace actually changes, and it exits untouched whenever
the focused workspace is the one already in the state file. That keeps a
running dwell clock alive across tab switches inside one workspace, and it also
swallows the extra workspace.focused this plugin's own workspace.move raises.

A generation counter makes rapid switching safe: each CHANGE of focused
workspace bumps it, and a waking child that finds a newer generation exits
without touching anything. The parent never blocks, so the event hook cannot
stall Herdr's UI.

The pinned workspace (default: home, label "~") is always held at index 0.

Settings are read from the environment, pre-filled from $HERDR_PLUGIN_CONFIG_DIR/.env
so they survive across sessions. Herdr injects that directory, and the detached child
inherits the parent environment, so both halves of the hook see the same settings.
An unreadable line or an unparsable value falls back to the default rather than
failing: this hook has no screen, and it must always exit 0.
"""
import json, os, socket, subprocess, sys, time, itertools


def load_env_file(path):
    """Pre-fill os.environ from simple KEY=VALUE lines in path.

    The real environment wins: a key already set is left untouched. Blank lines,
    "#" comments and lines without "=" are skipped, and one layer of matching
    single or double quotes is stripped from the value. A missing or unreadable
    file is a no-op — an absent config file is the normal case, not an error.
    """
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        return
    for line in lines:
        line = line.strip()
        # Skip silently: no screen, must exit 0 — one bad line must not stop the reorder.
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            os.environ.setdefault(key, value)


CONFIG_DIR = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
if CONFIG_DIR:
    load_env_file(os.path.join(CONFIG_DIR, ".env"))

DEFAULT_DWELL = 10.0
try:
    DWELL_SECONDS = float(os.environ.get("HERDR_RECENT_DWELL", DEFAULT_DWELL))
except ValueError:
    DWELL_SECONDS = DEFAULT_DWELL      # same rule: a typo falls back, it never breaks the hook
PINNED_LABEL = os.environ.get("HERDR_RECENT_PIN", "~")
PROMOTE_INDEX = 1                      # index 0 belongs to the pin

STATE_DIR = os.environ.get("HERDR_PLUGIN_STATE_DIR") or os.path.expanduser("~/.config/herdr")
STATE = os.path.join(STATE_DIR, "recent-spaces-state.json")
SOCK = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
_ids = itertools.count(1)

def call(method, params=None):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps({"id": f"recent-{next(_ids)}", "method": method,
                               "params": params or {}}) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf.split(b"\n")[0].decode())
    finally:
        s.close()

def workspaces():
    return call("workspace.list").get("result", {}).get("workspaces", [])

def read_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {}

def write_state(d):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, STATE)

def hold_pin(ws, order):
    """Keep the pinned workspace at index 0."""
    pin = next((w["workspace_id"] for w in ws if w.get("label") == PINNED_LABEL), None)
    if pin and order and order.index(pin) != 0:
        try:
            call("workspace.move", {"workspace_id": pin, "insert_index": 0})
        except Exception:
            pass
    return pin

def on_focus():
    """Runs synchronously on the event. Stamps state, spawns the waiter, exits."""
    ws = workspaces()
    if not ws:
        return
    order = [w["workspace_id"] for w in ws]
    pin = hold_pin(ws, order)

    current = next((w["workspace_id"] for w in ws if w.get("focused")), None)
    if not current or current == pin:
        return

    # Same workspace as last time: leave the state, and the dwell clock the
    # waiting child is counting down, exactly as they are. tab.focused fires on
    # every tab switch, so re-stamping here would restart the clock forever and
    # a workspace being actively worked in would never be promoted.
    state = read_state()
    if state.get("workspace_id") == current:
        return

    gen = int(state.get("generation", 0)) + 1
    write_state({"workspace_id": current, "since": time.time(), "generation": gen})

    # Detached: parent must not block Herdr's event pipeline for the dwell period.
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--await", str(gen)],
                     start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def await_dwell(gen):
    """Runs detached. Promotes only if focus never moved during the dwell."""
    time.sleep(DWELL_SECONDS)

    state = read_state()
    if int(state.get("generation", -1)) != gen:
        return                                  # focus moved on; a newer child owns this

    target = state.get("workspace_id")
    ws = workspaces()
    if not ws or not target:
        return

    live = {w["workspace_id"]: w for w in ws}
    if target not in live or not live[target].get("focused"):
        return                                  # closed, or no longer focused

    order = [w["workspace_id"] for w in ws]
    pin = hold_pin(ws, order)
    if target == pin:
        return

    if order.index(target) != PROMOTE_INDEX:
        try:
            call("workspace.move", {"workspace_id": target, "insert_index": PROMOTE_INDEX})
        except Exception:
            pass

if __name__ == "__main__":
    try:
        if len(sys.argv) > 2 and sys.argv[1] == "--await":
            await_dwell(int(sys.argv[2]))
        else:
            on_focus()
    except Exception as e:
        print(f"promote-recent: {e}", file=sys.stderr)
    sys.exit(0)   # never fail the event hook
