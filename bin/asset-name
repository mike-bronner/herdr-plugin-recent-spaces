#!/bin/sh
# Prints the release-asset name for one platform.
#
# This is the only place that knows how a platform becomes an asset name, and
# that is the whole point of the file. The release workflow asks it to name the
# target it has just built; bin/build asks it to name the host it is running on.
# Two places computing the same name differently would publish `watch-X` and
# then look for `watch-Y`, which is a 404 on somebody else's machine and a
# silent fall back to compiling on the one machine that cannot compile.
#
# With a Rust target triple as its argument it names that target. The workflow
# cross-compiles, so the runner it builds on is not the platform it builds for,
# and only the triple tells the truth about the artifact.
#
# With no argument it names the host, from uname. An unrecognised host gets no
# name and a non-zero exit, never a guess: a wrong name would download a binary
# built for another platform and run it.
set -eu

triple="${1:-}"

if [ -z "$triple" ]; then
    case "$(uname -s)/$(uname -m)" in
        Darwin/arm64) triple="aarch64-apple-darwin" ;;
        Darwin/x86_64) triple="x86_64-apple-darwin" ;;
        Linux/aarch64) triple="aarch64-unknown-linux-musl" ;;
        Linux/x86_64) triple="x86_64-unknown-linux-musl" ;;
        *) exit 1 ;;
    esac
fi

printf 'watch-%s\n' "$triple"
