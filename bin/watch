#!/bin/sh
set -eu

PLUGIN_ROOT="${HERDR_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)}"
BIN="$PLUGIN_ROOT/target/release/watch"
MARK="$BIN.download"

say() { printf 'recent-spaces: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }

case "${1:-}" in
    --version)
        [ -x "$BIN" ] || die "no watcher binary at $BIN"
        HERDR_PLUGIN_ROOT="$PLUGIN_ROOT" exec "$BIN" --version
        ;;
esac

# Anchored at the start of the line, because herdr-plugin.toml also carries
# min_herdr_version and the Herdr floor is not the plugin version.
declared_version() {
    sed -n 's/^version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$PLUGIN_ROOT/herdr-plugin.toml" 2>/dev/null | head -1
}

downloaded_version() {
    sed -n 's/^version=//p' "$MARK" 2>/dev/null | head -1
}

# A downloaded binary and a compiled one go stale for different reasons, and
# asking the wrong question about either one breaks somebody.
#
# A compiled binary belongs to the source beside it, so mtimes answer: anything
# newer than the binary means the binary is behind. That is the developer loop
# and it is unchanged.
#
# A downloaded binary belongs to a *release*, not to the source beside it. On
# any commit after a release the source is permanently newer, so mtimes would
# say "rebuild" forever — on the one machine that has no toolchain to rebuild
# with. The honest question is which version it was downloaded for, against the
# version the manifest declares now. Those differ only when a release has been
# cut, which is exactly when a new binary exists to fetch.
#
# An unreadable version fails closed and builds: running an unknown binary
# quietly is worse than a build that may warn.
needs_build() {
    [ -x "$BIN" ] || return 0
    if [ -f "$MARK" ]; then
        declared="$(declared_version)"
        [ -n "$declared" ] || return 0
        [ "$declared" != "$(downloaded_version)" ]
    else
        [ -n "$(find "$PLUGIN_ROOT/src" "$PLUGIN_ROOT/Cargo.toml" "$PLUGIN_ROOT/Cargo.lock" \
                -newer "$BIN" -print -quit 2>/dev/null)" ]
    fi
}

if needs_build; then
    if HERDR_PLUGIN_ROOT="$PLUGIN_ROOT" sh "$PLUGIN_ROOT/bin/build"; then
        :
    elif [ -x "$BIN" ]; then
        say "the build failed; running the watcher already built, which may be stale"
    else
        die "no watcher binary at $BIN and it could not be built"
    fi
fi

[ -x "$BIN" ] || die "no watcher binary at $BIN"

exec "$BIN" "$@"
